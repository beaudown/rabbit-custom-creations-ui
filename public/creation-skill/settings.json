{
  "schemaVersion": 1,
  "ui": {
    "theme": "dark-glass",
    "minimumButtonHeightPx": 48,
    "preferredButtonHeightPx": 52,
    "baseFontSizePx": 17,
    "largeFontSizePx": 22,
    "highContrast": true,
    "spacing": "comfortable",
    "roundedCornersPx": 10
  },
  "broker": {
    "defaultDryRun": true,
    "approvalRequired": true,
    "denySupported": true,
    "sessionTtlSeconds": 600,
    "temporaryPrivilegeLifetime": "until_reboot",
    "initialAuthorizationTiming": "after_device_restart",
    "brokerLeaseTtlSeconds": 86400,
    "rabbitBrokerMayOperateWithoutMacAfterBootstrap": true,
    "creationSideEscalatedPrivilegeRequests": true,
    "brokerSideExecutionRequired": true,
    "macbookRequired": false,
    "remoteBrokerConfig": "../broker/remote-broker-config.json",
    "macLocalFallbackBrokerConfig": "../broker/mac-local-broker-config.json",
    "brokerCoordination": "../broker/broker-coordination.json",
    "remoteExecutorStatus": "not_deployed"
  },
  "audit": {
    "activeRecordTarget": 1500,
    "warningThreshold": 1200,
    "archiveChunkSize": 500,
    "archiveQueryable": true,
    "archiveTags": [
      "adb",
      "storage",
      "reboot",
      "apk",
      "prompt",
      "blocked",
      "rollback",
      "dry-run",
      "privilege"
    ]
  }
}
