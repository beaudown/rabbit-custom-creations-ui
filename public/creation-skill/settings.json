{
  "schemaVersion": 1,
  "ui": {
    "theme": "dark-glass",
    "minimumButtonHeightPx": 48,
    "preferredButtonHeightPx": 52,
    "baseFontSizePx": 17,
    "largeFontSizePx": 22,
    "highContrast": true,
    "spacing": "comfortable",
    "roundedCornersPx": 10
  },
  "broker": {
    "defaultDryRun": true,
    "approvalRequired": true,
    "denySupported": true,
    "sessionTtlSeconds": 600,
    "temporaryPrivilegeLifetime": "until_reboot",
    "initialAuthorizationTiming": "after_device_restart",
    "brokerLeaseTtlSeconds": 259200,
    "leasePairing": "../broker/lease-pairing.json",
    "rabbitConnectorAutoRetrievesLeasePairing": true,
    "rabbitBrokerMayOperateWithoutMacAfterBootstrap": true,
    "temporaryPrivilegeIndependentOfBrokerLeaseExpiry": true,
    "temporaryPrivilegeIndependentOfMacReachabilityAfterBootstrap": true,
    "creationSideEscalatedPrivilegeRequests": true,
    "brokerSideExecutionRequired": true,
    "macbookRequired": false,
    "remoteBrokerConfig": "../broker/remote-broker-config.json",
    "macLocalFallbackBrokerConfig": "../broker/mac-local-broker-config.json",
    "brokerCoordination": "../broker/broker-coordination.json",
    "remoteExecutorStatus": "not_deployed"
  },
  "launcher": {
    "singleCreationEntrypoint": true,
    "hostedPwaDefaultUrl": "https://beaudown.github.io/rabbit-custom-creations-ui/",
    "creationLauncher": "creation-launcher.json",
    "firstRunReadiness": "first-run-readiness.md",
    "brokerServiceGuide": "broker-service-guide.md",
    "detectBridgeOnLaunch": true,
    "detectMacFallbackOnLaunch": true,
    "detectRabbitBrokerOnLaunch": true,
    "serviceControlEndpoint": "/broker/service",
    "serviceControlDefaultDryRun": true
  },
  "customSkillUploader": {
    "enabled": true,
    "defaultDryRun": true,
    "template": "../broker/request-templates/custom-skill-upload-request.json",
    "guide": "custom-skill-uploader.md",
    "hooksRequireTemporarySuperuser": true,
    "hooksRequireBrokerApproval": true,
    "automaticHookActivation": false,
    "acceptedExtensions": [
      ".txt",
      ".md",
      ".csv",
      ".json",
      ".yaml",
      ".yml",
      ".toml",
      ".xml",
      ".pdf",
      ".zip"
    ]
  },
  "audit": {
    "activeRecordTarget": 1500,
    "warningThreshold": 1200,
    "archiveChunkSize": 500,
    "archiveQueryable": true,
    "archiveTags": [
      "adb",
      "storage",
      "reboot",
      "apk",
      "prompt",
      "blocked",
      "rollback",
      "dry-run",
      "privilege"
    ]
  }
}
