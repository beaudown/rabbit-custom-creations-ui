{
  "schemaVersion": 1,
  "name": "mac-local-fallback-broker",
  "status": "specified_not_running",
  "intendedHost": "mac",
  "role": "fallback_lab_bootstrap_coordinator",
  "finalRuntime": false,
  "macbookRequired": true,
  "coordinationManifest": "broker/broker-coordination.json",
  "syncManifest": "broker/sync-manifest.json",
  "sharedAuditLog": "broker/audit-log.jsonl",
  "sharedTemplates": "broker/request-templates/",
  "sharedQueueInbox": "broker/queue/inbox/",
  "leasePairing": "broker/lease-pairing.json",
  "defaultLeaseTtlSeconds": 259200,
  "localApi": {
    "preferredBaseUrl": "http://127.0.0.1:8792",
    "endpoints": [
      "GET /health",
      "GET /state",
      "POST /lease",
      "POST /requests",
      "POST /approve",
      "POST /deny"
    ]
  },
  "bootstrapRole": {
    "mayCoordinateRabbitNativeInstall": true,
    "mayQueuePrivilegeBootstrapRequest": true,
    "mayBootstrapRestartScopedPrivilegeSession": true,
    "mayBootstrapRabbitNativeBrokerEscalation": true,
    "rabbitNativeBrokerMayOperateWithoutMacAfterBootstrap": true,
    "rabbitNativeBrokerMayRequestTemporarySuperuserWithoutMacAfterBootstrap": true,
    "mayWritePresenceForRemoteBroker": true,
    "mayWriteAuditRecords": true,
    "containsRootPayload": false,
    "performsSilentPrivilegeEscalation": false
  },
  "executionPolicy": {
    "singleWriterLeaseRequired": true,
    "leaseControlsExecutionResultWritesOnly": true,
    "yieldToRabbitNativeBroker": true,
    "defaultLeaseTtlSeconds": 259200,
    "regenerateLeaseOnMacBrokerStartup": true,
    "regenerateLeaseWhenMacBecomesAvailable": true,
    "privilegedExecutionEnabled": false,
    "requiresSeparateLiveDeviceAuthorization": true,
    "initialLiveAuthorizationTiming": "after_device_restart",
    "temporaryPrivilegeLifetime": "until_reboot",
    "temporaryPrivilegeIndependentOfLeaseExpiry": true,
    "temporaryPrivilegeIndependentOfMacReachabilityAfterBootstrap": true,
    "remoteFlashingDefault": "blocked",
    "otaBreakingModificationDefault": "blocked"
  }
}
