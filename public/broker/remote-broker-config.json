{
  "schemaVersion": 1,
  "status": "not_deployed",
  "githubPagesIsStaticOnly": true,
  "recommendedRuntime": "rabbit_native_service",
  "rabbitNativeBrokerSpec": "broker/rabbit-native-broker-spec.json",
