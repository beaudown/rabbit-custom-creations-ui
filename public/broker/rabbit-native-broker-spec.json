{
  "schemaVersion": 1,
  "name": "rabbit-native-broker",
  "status": "specified_not_installed",
  "intendedHost": "rabbit_r1",
  "macbookRequired": false,
  "githubRole": "manifests_templates_prompts_audit_storage",
  "creationRole": "caller_and_user_interface",
  "bridgeRole": "local_creation_to_on_device_broker_api",
  "gatewayTopology": "broker/gateway-topology.json",
  "gatewayIntegrations": [
    "rabbit_gateway_connector",
    "openclaw_gateway",
    "hermes_gateway",
    "claude_client",
    "chatgpt_codex_client",
    "rabbit_intern",
    "dlam_synthesis"
  ],
  "brokerRole": "validator_decider_executor_when_validated",
  "installStatus": {
    "installedOnRabbit": false,
    "validatedOnRabbit": false,
    "privilegedExecutionAvailable": false,
    "otaSafeInstallPathValidated": false
  },
  "localApi": {
    "preferredBaseUrl": "http://127.0.0.1:8791",
    "endpoints": [
      "GET /health",
      "GET /hints",
      "GET /state",
      "GET /gateways",
      "GET /bridge/status",
      "GET /bridge/route",
      "GET /adb/status",
      "POST /requests",
      "POST /approve",
      "POST /deny",
      "POST /adb/usb",
      "POST /adb/tcpip",
      "POST /adb/authorize",
      "POST /adb/broadcast",
      "POST /device/reboot-mode",
      "POST /audit/handoff",
      "POST /broker/service",
      "POST /skills/upload"
    ]
  },
  "remoteApi": {
    "enabledByDefault": false,
    "requiresAuthentication": true,
    "requiresExplicitEnable": true,
    "intendedUse": "allow remote request intake while Rabbit is away from MacBook"
  },
  "privilegedRequestClasses": [
    "request_temporary_privilege_session",
    "prepare_adb_enable_request",
    "prepare_adb_tcpip_request",
    "prepare_adb_authorization_prompt_request",
    "prepare_adb_awareness_broadcast_request",
    "prepare_reboot_request",
    "prepare_usb_storage_reboot_mode_request",
    "prepare_usb_mass_storage_request",
    "prepare_broker_service_control_request",
    "prepare_custom_skill_upload_request",
    "prepare_apk_canary_request"
  ],
  "customSkillUploadPolicy": {
    "singleCreationModule": true,
    "acceptedExtensions": [
      ".txt",
      ".md",
      ".csv",
      ".json",
      ".yaml",
      ".yml",
      ".toml",
      ".xml",
      ".pdf",
      ".zip"
    ],
    "automaticHookActivation": false,
    "hookActivationRequiresTemporarySuperuser": true,
    "hookActivationRequiresBrokerApproval": true,
    "auditEverySkillImport": true
  },
  "bridgeRoutingPolicy": {
    "bridgeIsRouterNotExecutor": true,
    "preferMacFallbackWhenLocalReachableAndLeaseValid": true,
    "fallbackToRabbitNativeBrokerWhenMacUnavailable": true,
    "rabbitNativeBrokerIsDefaultOnDeviceRoute": true,
    "showExpectedOutputBeforeQueueing": true,
    "showBlockersAndHintsBeforeApproval": true,
    "queueDryRunBeforeLiveAction": true,
    "routeTargetRequiredBeforeQueueing": true,
    "assistantClientsMaySuggestRequests": true,
    "assistantClientsMayExecutePrivilegedActions": false
  },
  "adbPolicy": {
    "adbOverUsbIsFirstClassWorkflow": true,
    "adbOverTcpipIsFirstClassWorkflow": true,
    "systemAuthorizationPromptTracked": true,
    "systemAuthorizationPromptRequiresLiveSupport": true,
    "ordinaryCreationCannotAuthorizeAdbAlone": true,
    "broadcastTransportAwareness": true,
    "awarenessFields": [
      "usb_state",
      "tcpip_state",
      "authorization_state",
      "transport_blockers",
      "discovery_hints"
    ]
  },
  "deviceModePolicy": {
    "normalReboot": true,
    "recoveryReboot": true,
    "fastbootReboot": true,
    "usbStorageModeReboot": true,
    "usbStorageModeRequiresDiscovery": true,
    "remoteFlashingStillBlockedByDefault": true
  },
  "offlineRecoveryPolicy": {
    "cacheOnDevice": true,
    "auditLookupOffline": true,
    "rollbackHelpOffline": true,
    "debugHelpOffline": true,
    "searchFields": [
      "request_id",
      "action",
      "broker_id",
      "route_target",
      "device_state",
      "artifact_sha256",
      "created_at",
      "rollback_note"
    ]
  },
  "defaultBlocks": [
    "persistent_root",
    "ota_breaking_modification",
    "remote_flashing",
    "erase_partition",
    "slot_change",
    "arbitrary_shell_without_high_risk_mode"
  ],
  "safetyDefaults": {
    "dryRunFirst": true,
    "requiresApproveOrDeny": true,
    "requiresLiveDeviceCheck": true,
    "defaultSessionLifetime": "until_reboot",
    "initialAuthorizationTiming": "after_device_restart",
    "rebootClearsTemporaryPrivilege": true,
    "persistentChangeDefault": false,
    "auditEveryRequest": true
  },
  "leasePolicy": {
    "defaultLeaseTtlSeconds": 259200,
    "leaseLabel": "72_hour_lease",
    "rabbitNativeBrokerMayRenewWithoutMacAfterBootstrap": true,
    "macLocalBrokerBootstrapRequiredInitially": true,
    "macLocalBrokerRequiredAfterBootstrap": false,
    "leaseControlsExecutionResultWritesOnly": true,
    "leasePairingPath": "broker/lease-pairing.json",
    "rabbitConnectorAutoRetrievesLeasePairing": true,
    "leaseManagerEndpoints": [
      "GET /lease/pairing",
      "POST /lease/refresh",
      "POST /lease/renew",
      "POST /lease/release"
    ],
    "leaseActionsAffectSuperuserSession": false,
    "temporaryPrivilegeStillExpiresOnRestart": true
  },
  "superuserSessionPolicy": {
    "scope": "current_boot_cycle_ram_only",
    "initialBootstrapAuthority": "mac_local_fallback_broker",
    "rabbitNativeBrokerCallableAfterBootstrap": true,
    "rabbitNativeBrokerMayRequestTemporarySuperuserWithoutMacAfterBootstrap": true,
    "independentOfMacReachabilityAfterBootstrap": true,
    "independentOfBrokerLeaseExpiry": true,
    "expiresOn": "rabbit_restart",
    "persistentSystemModificationDefault": "blocked"
  }
}
