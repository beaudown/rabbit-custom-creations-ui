{
  "schemaVersion": 1,
  "purpose": "shared broker presence, lease, and coordination state",
  "status": "seed",
  "singleWriterPolicy": {
    "enabled": true,
    "leaseTtlSeconds": 259200,
    "leaseLabel": "72_hour_lease",
    "renewalPolicy": "regenerate_on_mac_broker_startup_or_renew_on_broker_heartbeat_or_request",
    "executionResultWriter": "active_lease_holder",
    "denyExecutionWithoutLease": true,
    "rabbitNativeBrokerMayRenewWithoutMacAfterBootstrap": true,
    "leaseControlsExecutionResultWritesOnly": true,
    "leaseDoesNotGateRabbitNativeSuperuserSession": true
  },
  "leasePairing": {
    "path": "broker/lease-pairing.json",
    "qrTarget": "broker/lease-pairing.json",
    "rabbitConnectorAutoRetrieve": true,
    "refreshOnMacBrokerStartup": true,
    "refreshWhenMacBrokerBecomesAvailable": true
  },
  "gatewayTopology": {
    "path": "broker/gateway-topology.json",
    "rabbitBridgeIncluded": true,
    "rabbitGatewayConnectorIncluded": true,
    "openClawGatewayAware": true,
    "hermesGatewayAware": true,
    "gatewaysMayNotOverrideActiveBroker": true
  },
  "preferredExecutorOrder": [
    "rabbit-native",
    "mac-local-fallback",
    "remote-intake-only"
  ],
  "knownBrokers": [
    {
      "id": "rabbit-native",
      "role": "primary_on_device_executor",
      "host": "rabbit_r1",
      "status": "specified_not_installed",
      "canExecutePrivilegedRequests": false,
      "macbookRequired": false,
      "lastSeen": null
    },
    {
      "id": "mac-local-fallback",
      "role": "fallback_lab_bootstrap_coordinator",
      "host": "mac",
      "status": "specified_not_running",
      "canExecutePrivilegedRequests": false,
      "macbookRequired": true,
      "lastSeen": null
    }
  ],
  "activeLease": null,
  "rules": {
    "githubIsSharedStateNotExecutor": true,
    "macBrokerMayBootstrapRabbitBroker": true,
    "macBrokerMayBootstrapRestartScopedPrivilegeSession": true,
    "rabbitBrokerMayOperateWithoutMacAfterBootstrap": true,
    "macBrokerMayNotOverrideActiveRabbitBroker": true,
    "privilegedExecutionRequiresSeparateLiveAuthorization": true,
    "initialLiveAuthorizationTiming": "after_device_restart",
    "temporaryPrivilegeLifetime": "until_reboot",
    "temporaryPrivilegeIndependentOfLeaseExpiry": true,
    "temporaryPrivilegeIndependentOfMacReachabilityAfterBootstrap": true,
    "persistentRootDefault": "blocked",
    "otaBreakingModificationDefault": "blocked"
  }
}
