{
  "schemaVersion": 1,
  "name": "superuser-management-gateway-topology",
  "purpose": "Defines the routed gateway stack under the unified Superuser Management Creation.",
  "superuserManagementIncludes": [
    "creation_ui",
    "rabbit_bridge",
    "rabbit_native_broker",
    "rabbit_gateway_connector",
    "openclaw_gateway",
    "hermes_gateway",
    "rabbit_llm",
    "claude_client",
    "chatgpt_codex_client",
    "rabbit_intern",
    "dlam_synthesis",
    "mac_local_fallback_broker",
    "github_storage"
  ],
  "nodes": [
    {
      "id": "creation_ui",
      "label": "Superuser Management Creation",
      "host": "rabbit_r1_creation",
      "role": "touch_ui_and_request_caller",
      "mayExecutePrivilegedActions": false
    },
    {
      "id": "rabbit_bridge",
      "label": "Rabbit bridge",
      "host": "rabbit_r1",
      "role": "local_creation_to_broker_bridge",
      "mayExecutePrivilegedActions": false
    },
    {
      "id": "rabbit_native_broker",
      "label": "Rabbit on-device broker",
      "host": "rabbit_r1",
      "role": "primary_validator_decider_executor_when_validated",
      "status": "specified_not_installed",
      "mayExecutePrivilegedActions": false
    },
    {
      "id": "rabbit_gateway_connector",
      "label": "Rabbit gateway connector",
      "host": "rabbit_r1",
      "role": "github_manifest_prompt_template_and_lease_retrieval",
      "mayExecutePrivilegedActions": false
    },
    {
      "id": "openclaw_gateway",
      "label": "OpenClaw gateway",
      "host": "mac_or_openclaw_runtime",
      "role": "federated_memory_remote_admin_context_and_gateway_awareness",
      "executionBoundary": "does_not_supersede_rabbit_native_broker_or_live_device_authorization"
    },
    {
      "id": "hermes_gateway",
      "label": "Hermes gateway",
      "host": "hermes_runtime_when_available",
      "role": "assistant_bridge_and_handoff_consumer",
      "maySuggestRequests": true,
      "mayReviewAuditBundles": true,
      "mayExecutePrivilegedActions": false,
      "verificationBoundary": "claims_require_tool_evidence_or_handoff_confirmation"
    },
    {
      "id": "rabbit_llm",
      "label": "Rabbit LLM",
      "host": "rabbit_r1",
      "role": "on_device_audit_review_and_next_step_guidance",
      "maySuggestRequests": true,
      "mayReviewAuditBundles": true,
      "mayExecutePrivilegedActions": false
    },
    {
      "id": "claude_client",
      "label": "Claude",
      "host": "assistant_runtime",
      "role": "structured_request_and_audit_review_client",
      "maySuggestRequests": true,
      "mayReviewAuditBundles": true,
      "mayExecutePrivilegedActions": false
    },
    {
      "id": "chatgpt_codex_client",
      "label": "ChatGPT/Codex",
      "host": "assistant_runtime_or_mac",
      "role": "implementation_review_and_request_structuring_client",
      "maySuggestRequests": true,
      "mayReviewAuditBundles": true,
      "mayExecutePrivilegedActions": false
    },
    {
      "id": "rabbit_intern",
      "label": "Rabbit intern",
      "host": "rabbit_or_assistant_runtime",
      "role": "guided_prompt_and_user_next_step_client",
      "maySuggestRequests": true,
      "mayReviewAuditBundles": true,
      "mayExecutePrivilegedActions": false
    },
    {
      "id": "dlam_synthesis",
      "label": "DLAM",
      "host": "distributed_assistant_layer",
      "role": "multi_agent_audit_context_and_expected_outcome_synthesis",
      "maySuggestRequests": true,
      "mayReviewAuditBundles": true,
      "mayExecutePrivilegedActions": false
    },
    {
      "id": "mac_local_fallback_broker",
      "label": "Mac local broker",
      "host": "mac",
      "role": "fallback_lab_bootstrap_and_lease_coordinator",
      "mayExecutePrivilegedActions": false
    },
    {
      "id": "github_storage",
      "label": "GitHub storage",
      "host": "github_pages_or_repository",
      "role": "static_ui_queue_manifest_prompt_audit_storage",
      "mayExecutePrivilegedActions": false
    }
  ],
  "routes": [
    "creation_ui -> rabbit_bridge -> rabbit_native_broker",
    "creation_ui -> rabbit_gateway_connector -> github_storage",
    "creation_ui -> openclaw_or_hermes_authenticated_relay -> mac_local_fallback_broker",
    "rabbit_native_broker -> github_storage",
    "mac_local_fallback_broker -> github_storage",
    "openclaw_gateway -> github_storage",
    "hermes_gateway -> github_storage",
    "rabbit_llm -> github_storage",
    "claude_client -> github_storage",
    "chatgpt_codex_client -> github_storage",
    "rabbit_intern -> github_storage",
    "dlam_synthesis -> github_storage"
  ],
  "rules": {
    "singleUserFacingTool": "superuser_management",
    "githubIsStorageNotExecutor": true,
    "creationIsCallerNotExecutor": true,
    "bridgeIsRouterNotExecutor": true,
    "rabbitNativeBrokerIsPreferredExecutor": true,
    "rabbitBridgeConnectsCreationToOnDeviceBroker": true,
    "rabbitBridgeSelectsMacFallbackWhenReachable": true,
    "rabbitBridgeFallsBackToOnDeviceBroker": true,
    "rabbitGatewayConnectorRetrievesHostedState": true,
    "openClawGatewayIsCoordinationAware": true,
    "hermesGatewayIsCoordinationAware": true,
    "assistantClientsMayReviewAuditBundles": true,
    "assistantClientsMaySuggestRequests": true,
    "assistantClientsMayExecutePrivilegedActions": false,
    "gatewayClaimsRequireEvidence": true,
    "privilegedExecutionRequiresValidatedRabbitExecutor": true,
    "noDeviceCommandFromGatewayTopology": true
  },
  "relayProbe": {
    "endpoint": "/gateway/relay/probe",
    "purpose": "Check whether OpenClaw or Hermes can safely front the broker before a new Rabbit QR is generated.",
    "statusDefault": "relay_not_ready",
    "allowlist": [
      "GET /rabbit-broker/health",
      "GET /rabbit-broker/actions/catalog",
      "POST /rabbit-broker/actions",
      "GET /rabbit-broker/audit/:auditId"
    ],
    "requiresHttps": true,
    "requiresAuth": true,
    "exposesGatewaySecrets": false,
    "mayExecutePrivilegedActions": false,
    "stopConditions": [
      "No HTTPS route reachable from Rabbit.",
      "No auth on a public route.",
      "Relay would expose OpenClaw or Rabbit connector tokens.",
      "Relay attempts root, ADB, reboot, install, fastboot, recovery, shell, or flash directly.",
      "Relay cannot write an audit record."
    ],
    "futureSkillShape": "OpenClaw or Hermes assistant tool exposes the allowlist, forwards to active broker, returns warnings, blockers, audit ID, and privilegedExecutionPerformed=false unless a validated Rabbit-native broker later executes."
  }
}
